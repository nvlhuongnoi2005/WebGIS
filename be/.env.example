# Copy to be/.env and replace every CHANGE_ME value. This file is read by
# `npm run auth:dev`; it is never bundled into the Vite frontend.
AUTH_PORT=3001

# Use a private port mapping when running the backend on the host, or the
# Postgres service DNS name when running it in the same Docker/Kubernetes network.
DATABASE_URL=postgresql://AUTH_DB_USER:CHANGE_ME@localhost:5432/AUTH_DB_NAME

APP_ORIGINS=http://localhost:5173
AUTH_JWT_ISSUER=auth-service
AUTH_JWT_AUDIENCE=api-gateway
AUTH_JWT_KID=dev-1
AUTH_DEV_EPHEMERAL_KEYS=true
# A session becomes invalid if the user has not interacted with the app for this long.
AUTH_SESSION_IDLE_TIMEOUT_SECONDS=7200
AUTH_REFRESH_TOKEN_PEPPER=CHANGE_ME_USE_A_RANDOM_32_BYTE_SECRET
AUTH_SECURE_COOKIES=false
VALHALLA_INTERNAL_URL=http://localhost:8002
TILE_SERVER_INTERNAL_URL=http://localhost:8080
NOMINATIM_INTERNAL_URL=http://localhost:8083
# Optional private Elasticsearch endpoint for autocomplete/suggestions.
ELASTICSEARCH_URL=http://localhost:9200

# Production only: load both PEM values from a secret manager, never Git.
# AUTH_JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n..."
# AUTH_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\\n..."
# During key rotation, retain old public keys until all old access tokens expire.
# AUTH_JWT_PREVIOUS_PUBLIC_KEYS='[{"kid":"previous-1","publicKey":"-----BEGIN PUBLIC KEY-----\\n..."}]'
